    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst clean = (s) => String(s || '').toLowerCase().replace(/[^a-z0-9_-]/g, '').slice(0, 60);\nconst ids = body.ecosistema_ids || {};\nconst num = (v) => (Number.isInteger(Number(v)) && Number(v) > 0) ? String(Number(v)) : '';\nconst idStr = (v) => /^[A-Za-z0-9_]{3,40}$/.test(String(v || '')) ? String(v) : '';\nconst instance = clean(body.evolution_instance);\nconst evo = 'https://evolution.qxao.dpdns.org', chat = 'https://chat.qxao.dpdns.org', crm = 'https://crm.qxao.dpdns.org';\nconst accId = num(ids.chatwoot_account_id), usrId = num(ids.chatwoot_user_id), baseId = idStr(ids.nocodb_base_id);\nreturn [{ json: {\n  instance, accId, usrId, baseId,\n  skip: { evolution: !instance, chatwoot_account: !accId, chatwoot_user: !usrId, nocodb: !baseId },\n  url_logout: instance ? `${evo}/instance/logout/${instance}` : '',\n  url_evo: instance ? `${evo}/instance/delete/${instance}` : '',\n  url_acc: accId ? `${chat}/platform/api/v1/accounts/${accId}` : '',\n  url_usr: usrId ? `${chat}/platform/api/v1/users/${usrId}` : '',\n  url_base: baseId ? `${crm}/api/v2/meta/bases/${baseId}` : ''\n} }];"
      },
