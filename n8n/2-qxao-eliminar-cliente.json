    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst st = (n) => { try { return $(n).first().json; } catch (e) { return {}; } };\nconst ok = (r) => (r.statusCode >= 200 && r.statusCode < 300) || r.statusCode === 404;\nconst steps = [\n  ['Evolution eliminar', cfg.skip.evolution, st('Evolution eliminar')],\n  ['Chatwoot cuenta', cfg.skip.chatwoot_account, st('Chatwoot eliminar cuenta')],\n  ['Chatwoot usuario', cfg.skip.chatwoot_user, st('Chatwoot eliminar usuario')],\n  ['NocoDB base', cfg.skip.nocodb, st('NocoDB eliminar base')]\n];\nconst failures = [], skipped = [];\nfor (const [label, skip, r] of steps) {\n  if (skip) { skipped.push(label); continue; }\n  if (!ok(r)) failures.push(label + ': ' + (r.statusCode ? 'HTTP ' + r.statusCode : (r.error && r.error.message) || 'sin respuesta'));\n}\nconst out = { success: failures.length === 0, skipped };\nif (failures.length) out.error = 'No se pudo limpiar: ' + failures.join('; ');\nreturn [{ json: out }];"
      },
