    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst clean = (s) => String(s || '').toLowerCase().replace(/[^a-z0-9_-]/g, '').slice(0, 60);\nconst instance = clean(body.evolution_instance);\nif (instance.length < 2) throw new Error('evolution_instance invalido o vacio');\nif (!body.client_id) throw new Error('client_id requerido');\nif (!body.email) throw new Error('email requerido');\nfunction rnd(n) {\n  const a = new Uint32Array(n);\n  if (typeof crypto !== 'undefined' && crypto.getRandomValues) crypto.getRandomValues(a);\n  else for (let i = 0; i < n; i++) a[i] = Math.floor(Math.random() * 4294967296);\n  return a;\n}\nconst sets = ['ABCDEFGHJKLMNPQRSTUVWXYZ', 'abcdefghijkmnopqrstuvwxyz', '23456789', '!@#$%*-_'];\nconst all = sets.join('');\nconst r = rnd(20);\nlet password = '';\nfor (let i = 0; i < 4; i++) password += sets[i][r[i] % sets[i].length];\nfor (let i = 4; i < 20; i++) password += all[r[i] % all.length];\nreturn [{ json: {\n  client_id: body.client_id,\n  email: String(body.email).trim(),\n  full_name: body.full_name || body.company_name || instance,\n  company_name: body.company_name || instance,\n  instance,\n  password,\n  evo: 'https://evolution.qxao.dpdns.org', chat: 'https://chat.qxao.dpdns.org', crm: 'https://crm.qxao.dpdns.org', n8n: 'https://n8n.qxao.dpdns.org'\n} }];"
      },
