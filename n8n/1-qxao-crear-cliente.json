      "parameters": {
        "jsCode": "// PLANTILLA DE TABLAS DE CADA CLIENTE: edita esta lista para cambiar lo que recibe cada cliente nuevo.\nconst T = (name, cols) => ({ json: {\n  table_name: name, title: name,\n  columns: [{ column_name: 'id', title: 'Id', uidt: 'ID' }].concat(cols.map(([n, t]) => ({ column_name: n, title: n, uidt: t })))\n} });\nreturn [\n  T('leads', [['nombre', 'SingleLineText'], ['telefono', 'SingleLineText'], ['email', 'SingleLineText'], ['estado', 'SingleLineText'], ['notas', 'LongText']]),\n  T('productos', [['nombre', 'SingleLineText'], ['descripcion', 'LongText'], ['precio', 'Decimal'], ['disponible', 'Checkbox']]),\n  T('pedidos', [['cliente', 'SingleLineText'], ['telefono', 'SingleLineText'], ['detalle', 'LongText'], ['total', 'Decimal'], ['estado', 'SingleLineText']])\n];"
      },
